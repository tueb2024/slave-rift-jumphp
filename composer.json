{
  "name": "tueb2024/slave-rift-jumphp",
  "description": "Original low-poly FPS experiment for JumPHP",
  "type": "project",
  "license": "GPL-3.0-or-later",
  "require": {
    "php": ">=8.2",
    "jumphp/engine": "@dev"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "JumPHP\\Input\\": "patches/JumPHP/Input/",
      "App\\": "src/"
    }
  },
  "config": {
    "sort-packages": true,
    "platform-check": false
  }
}
